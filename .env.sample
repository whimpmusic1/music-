# Get API_ID and API_HASH from https://my.telegram.org -> API Development Tools
API_ID=123456
API_HASH=your_api_hash_here

# Create a bot with @BotFather on Telegram, copy the token it gives you
BOT_TOKEN=123456789:AA_your_bot_token_here

# A Pyrogram *user* session string for the "assistant" account that actually
# joins the voice chat (bots cannot join VCs directly). Generate it by running:
#   python generate_session.py
SESSION_STRING=your_pyrogram_user_session_string_here

# Your numeric Telegram user ID (optional, used for owner-only commands later)
OWNER_ID=0

# Safety cap in minutes for how long a single track/video may play
DURATION_LIMIT_MIN=60

# One of: SD_240p, SD_360p, SD_480p, HD_720p, HD_1080p, FHD_1080p
VIDEO_QUALITY=SD_480p
